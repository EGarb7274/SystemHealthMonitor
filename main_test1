//imports the FileType class to allow file traversal
import groovy.io.FileType

//defines a class to scan directories and extract IDs from lines
class dirScanner {
    def files(str = dirPath) {
        return null
    }

    def extractID(String line) {
    line.replaceAll(/[^0-9]/, "")
    int end = line.indexOf(')')
    return line.substring(end + 2)
    }
}
//creates an instance of the dirScanner class and sets up directory scanning
def findFile = new dirScanner()
//gets the current working directory
